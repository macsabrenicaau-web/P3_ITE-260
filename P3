def View_All_Hotlines(hotlines):
    print("\nALL HOTLINES")

    for hotline in hotlines:
        print("\nName:", hotline["name"])
        print("Number:", hotline["number"])
        print("Service:", hotline["Service"])


def Emergency_Hotlines(Category):
    while True:
        print("\n Find Hotline by Type of Emergency")
        print("[1] Fire and Rescue")
        print("[2] Police Assistance")
        print("[3] Medical Assistance")
        print("[4] Disaster Response")
        print("[5] Back to Main Menu")

        choice = input("\nEnter your choice (1-5): ")

        if choice == "1":
            selected = "Fire and Rescue"
        elif choice == "2":
            selected = "Police Assistance"
        elif choice == "3":
            selected = "Medical Assistance"
        elif choice == "4":
            selected = "Disaster Response"
        elif choice == "5":
            return
        else:
            print("Invalid choice. Please try again.")
            continue

        print("\nCategory:", selected)

        for hotline in Category[selected]:
            print("Name:", hotline["name"])
            print("Number:", hotline["number"])
            print("Service:", hotline["Service"])


def Safety_Tips(Tips):
    while True:
        print("\nSAFETY TIPS")
        print("[1] Fire Safety")
        print("[2] Medical Safety")
        print("[3] Crime Safety")
        print("[4] Flood Safety")
        print("[5] Back to Main Menu")

        choice = input("\nEnter your choice (1-5): ")

        if choice == "1":
            selected = "Fire Safety"

        elif choice == "2":
            selected = "Medical Safety"

        elif choice == "3":
            selected = "Crime Safety"

        elif choice == "4":
            selected = "Flood Safety"

        elif choice == "5":
